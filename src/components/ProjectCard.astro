---
/**
 * Fully clickable project card. Category, title and text are always visible below the image
 * (never hover-only). On hover/focus only the title turns blue; the image stays untouched.
 */
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { projectHref } from '../data/projects';

interface Props {
  project: Project;
  size?: 'large' | 'compact';
}

const { project, size = 'large' } = Astro.props;
const Heading = 'h3'; // Both card sizes sit directly under an h2 section heading.
---

<article class:list={['project-card', `project-card--${size}`]}>
  <a class="project-card__link" href={projectHref(project)}>
    <div class="project-card__media">
      <Image
        src={project.image}
        alt={project.imageAlt}
        widths={size === 'large' ? [420, 800, 1024] : [360, 720]}
        sizes={size === 'large' ? '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px' : '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px'}
      />
    </div>
    <div class="project-card__body" lang={project.lang}>
      <p class="project-card__category">{project.category}</p>
      <Heading class="project-card__title">{project.title}</Heading>
      {size === 'large' && <p class="project-card__text">{project.summary}</p>}
    </div>
  </a>
</article>

<style>
  .project-card {
    height: 100%;
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1024 / 728;
    background: var(--color-surface-muted);
  }

  .project-card--compact .project-card__media {
    aspect-ratio: 1024 / 615;
  }

  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--space-4);
    text-align: center;
  }

  .project-card--compact .project-card__body {
    padding: var(--space-3);
  }

  .project-card__category {
    color: var(--color-primary);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .project-card__title {
    font-size: var(--fs-h3);
    font-weight: 650;
    transition: color var(--duration-base) var(--ease);
  }

  .project-card--compact .project-card__title {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .project-card__link:hover .project-card__title,
  .project-card__link:focus-visible .project-card__title {
    color: var(--color-primary);
  }

  .project-card__text {
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: var(--fs-label);
  }

</style>
