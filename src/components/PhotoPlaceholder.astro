---
/**
 * TEMPORARY placeholder for Leonard's real photograph.
 * Replace the contents with an <Image> of the supplied photo; keep the same frame and aspect ratio.
 * Never substitute an AI-generated or stock portrait.
 */
import Icon from './Icon.astro';

interface Props {
  /** Width / height. Portrait by default. */
  ratio?: string;
  class?: string;
}

const { ratio = '4 / 5', class: className } = Astro.props;
---

<figure class:list={['photo-placeholder', className]} style={`--ratio: ${ratio}`} data-photo-placeholder>
  <div class="photo-placeholder__inner">
    <span class="photo-placeholder__icon"><Icon name="user" size={40} /></span>
    <figcaption>
      <span class="photo-placeholder__label">Portrait photo</span>
      <span class="photo-placeholder__note">Placeholder: Leonard’s photograph will go here</span>
    </figcaption>
  </div>
</figure>

<style>
  .photo-placeholder {
    width: 100%;
    aspect-ratio: var(--ratio);
    margin: 0;
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .photo-placeholder__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    background:
      linear-gradient(180deg, var(--color-primary-tint) 0%, var(--color-surface-muted) 100%);
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-small);
    text-align: center;
  }

  .photo-placeholder__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    background: var(--color-surface);
    border: 1px solid var(--color-primary-tint-strong);
    border-radius: 50%;
    color: var(--color-steel);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .photo-placeholder__label {
    color: var(--color-ink);
    font-weight: 600;
  }

  .photo-placeholder__note {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
</style>
