---
/**
 * Pill button. Renders <a> when href is given, otherwise <button>.
 * primary   = solid blue (main action)
 * secondary = light surface + visible stroke
 * on-deep   = for use on the dark Final Contact surface
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'on-deep';

interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  href?: string;
  variant?: Variant;
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  external = false,
  ...rest
} = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class:list={classes} {...externalAttrs} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease),
      border-color var(--duration-base) var(--ease),
      color var(--duration-base) var(--ease);
  }

  .btn--md {
    min-height: 44px;
    padding: 10px 20px;
    font-size: var(--fs-label);
  }

  .btn--lg {
    min-height: 52px;
    padding: 14px 28px;
    font-size: 1rem;
  }

  .btn--primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--color-primary-strong);
  }

  .btn--primary:active {
    background: #123b78;
  }

  .btn--secondary {
    background: var(--color-surface);
    border-color: var(--color-border-strong);
    color: var(--color-ink);
  }

  .btn--secondary:hover {
    background: var(--color-primary-tint);
    border-color: var(--color-primary);
  }

  .btn--secondary:active {
    background: var(--color-primary-tint-strong);
  }

  .btn--on-deep {
    background: var(--color-surface);
    color: var(--color-deep);
  }

  .btn--on-deep:hover {
    background: var(--color-primary-tint);
  }

  .btn--on-deep:active {
    background: var(--color-primary-tint-strong);
  }

  .btn :global(svg) {
    flex-shrink: 0;
  }
</style>
