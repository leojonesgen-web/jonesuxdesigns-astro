---
import type { ImageMetadata } from 'astro';
import IconTile from './IconTile.astro';

interface Props {
  label: string;
  percent: number;
  icon: ImageMetadata;
  iconSize?: number;
}

const { label, percent, icon, iconSize } = Astro.props;
---

<li class="skill-card">
  <IconTile icon={icon} iconSize={iconSize} />
  <div class="skill-card__details">
    <span class="skill-card__label">{label}</span>
    <div class="skill-card__meter">
      <span
        class="skill-card__bar"
        role="meter"
        aria-label={`${label} proficiency`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={percent}
      >
        <span class="skill-card__fill" style={`width: ${percent}%`}></span>
      </span>
      <span class="skill-card__badge" aria-hidden="true">{percent}%</span>
    </div>
  </div>
</li>

<style>
  .skill-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .skill-card__details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-card__label {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
  }

  .skill-card__meter {
    display: flex;
    align-items: center;
    gap: 21px;
  }

  .skill-card__bar {
    position: relative;
    width: 90px;
    height: 11px;
    overflow: hidden;
    background: var(--color-track);
    border-radius: 6px;
  }

  .skill-card__fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--color-royal);
    border-radius: 6px;
  }

  .skill-card__badge {
    padding: 2px 10px;
    background: var(--color-track);
    border-radius: 11px;
    color: var(--color-royal);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
  }
</style>
