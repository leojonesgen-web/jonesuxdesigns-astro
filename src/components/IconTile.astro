---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  /** Icon size as drawn in Figma (the tile itself is fixed). */
  iconSize?: number;
  size?: 'md' | 'lg';
}

const { icon, iconSize = 28, size = 'md' } = Astro.props;
---

<span class:list={['icon-tile', `icon-tile--${size}`]}>
  <Image src={icon} alt="" width={iconSize} height={iconSize} />
</span>

<style>
  .icon-tile {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background: var(--color-tile);
    border-radius: var(--radius-tile);
  }

  .icon-tile--md {
    width: 50px;
    height: 50px;
  }

  .icon-tile--lg {
    width: 54px;
    height: 54px;
    border-radius: 10px;
  }
</style>
