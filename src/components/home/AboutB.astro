---
/**
 * About PROPOSAL B: photo + four full-width stacked strength cards (icon + title + light text).
 * No secondary heading on the right; the cards match the photo's height.
 */
import AboutIntro from './AboutIntro.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import Icon from '../Icon.astro';
import { strengths } from '../../data/content';
---

<section class="section about-b" id="about" aria-labelledby="about-title" data-about-version="B">
  <div class="container">
    <AboutIntro />
    <div class="about-b__split">
      <div class="about-b__photo"><PhotoPlaceholder /></div>
      <ul class="about-b__list">
        {
          strengths.map((s) => (
            <li class="strength-card">
              <span class="strength-card__icon"><Icon name={s.icon} size={24} /></span>
              <div class="strength-card__body">
                <h3 class="strength-card__title">{s.title}</h3>
                <p class="strength-card__text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about-b {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .about-b__split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: stretch;
    margin-top: var(--space-6);
  }

  .about-b__photo {
    max-width: 440px;
  }

  /* Four cards share the photo's height */
  .about-b__list {
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .strength-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .strength-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-primary-tint-strong);
    border-radius: 12px;
    color: var(--color-primary);
  }

  .strength-card__icon :global(svg) {
    stroke-width: 2;
  }

  .strength-card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .strength-card__title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .strength-card__text {
    color: var(--color-text-muted);
    font-size: var(--fs-label);
  }

  @media (max-width: 1024px) {
    .about-b__split {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .about-b__photo {
      width: min(100%, 400px);
      margin-inline: auto;
    }

    .about-b__list {
      grid-template-rows: none;
    }
  }

  @media (max-width: 560px) {
    .strength-card {
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .strength-card__icon {
      width: 44px;
      height: 44px;
    }
  }
</style>
