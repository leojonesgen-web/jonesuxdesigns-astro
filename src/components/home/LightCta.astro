---
/** Light conversion point: a restrained invitation; visitors who aren't ready simply continue. */
import Icon from '../Icon.astro';
import { contactHref } from '../../data/site';
---

<aside class="light-cta" aria-label="Start a conversation">
  <div class="container">
    <div class="light-cta__inner">
      <p class="light-cta__text">Building a consumer AI product with similar UX challenges?</p>
      <a class="text-link" href={contactHref}>Let’s talk <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</aside>

<style>
  .light-cta {
    padding-bottom: var(--section-space);
  }

  .light-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-primary-tint);
    border-radius: var(--radius-card);
  }

  .light-cta__text {
    color: var(--color-ink);
    font-size: var(--fs-body-lg);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .light-cta__inner {
      padding: var(--space-4);
    }
  }
</style>
