---
/**
 * About / Why work with me.
 * Centred intro → split: portrait photo (left) | secondary heading, short paragraph and four
 * strengths as open rows (icon + title + one line) separated by hairline dividers (right).
 */
import SectionIntro from '../SectionIntro.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/leonard-portrait.png';
import Icon from '../Icon.astro';
import { strengths } from '../../data/content';
---

<section class="section about-split" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionIntro eyebrow="About me" title="Why work with me" id="about-title" align="center">
      <p>I’m Leonard, a Product, UX and UI designer focused on early-stage consumer (B2C) AI products.</p>
    </SectionIntro>
    <div class="about-split__layout">
      <div class="about-split__photo">
        <Image
          class="about-split__portrait"
          src={portrait}
          alt="Portrait of Leonard Jones"
          widths={[400, 600, 920, 1258]}
          sizes="(max-width: 1024px) min(100vw, 400px), 460px"
        />
      </div>
      <div class="about-split__content">
        <h3 class="about-split__heading">Making complex AI products understandable</h3>
        <p class="about-split__text">
          I organize information, structure flows and design clean interfaces, so people understand
          what the product does, what is happening and what to do next.
        </p>
        <ul class="strengths">
          {
            strengths.map((s) => (
              <li class="strengths__item">
                <span class="strengths__icon">
                  <Icon name={s.icon} size={22} />
                </span>
                <div class="strengths__label">
                  <h4 class="strengths__title">{s.title}</h4>
                  <p class="strengths__line">{s.line}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-split {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .about-split__layout {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    margin-top: var(--space-6);
  }

  /* Desktop: soft blue panel. The cut-out photo spans the full panel width, so the shape
     touches the panel's left, right and bottom edges; only the top has breathing room. */
  .about-split__layout {
    align-items: stretch;
  }

  .about-split__photo {
    display: flex;
    align-items: flex-end;
    width: 100%;
    max-width: 460px;
    padding-top: var(--space-6);
    overflow: hidden;
    background: linear-gradient(180deg, #eef4ff 0%, #dce8fd 100%);
    border-radius: 24px;
  }

  /* Cut-out portrait: transparent background, sits directly on the section */
  .about-split__portrait {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-split__content {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 580px;
  }

  .about-split__heading {
    font-size: var(--fs-h3);
    font-weight: 650;
  }

  .about-split__text {
    color: var(--color-text-muted);
    font-size: var(--fs-body-lg);
  }

  .strengths {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .strengths__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .strengths__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    background: var(--color-primary-tint);
    border-radius: 12px;
    color: var(--color-primary);
  }

  .strengths__icon :global(svg) {
    stroke-width: 2;
  }

  /* Open rows: text block carries the hairline separator */
  .strengths__label {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 88px;
    padding-block: var(--space-2);
  }

  .strengths__item:not(:last-child) .strengths__label {
    border-bottom: 1px solid var(--color-border);
  }

  .strengths__title {
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .strengths__line {
    color: var(--color-text-muted);
    font-size: var(--fs-label);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .about-split__heading,
    .about-split__text {
      text-align: center;
    }

    .about-split__layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    /* Mobile/tablet: no photo; the text follows the intro directly */
    .about-split__photo {
      display: none;
    }

    .about-split__content {
      max-width: 600px;
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .strengths__item {
      gap: var(--space-3);
    }

    .strengths__label {
      min-height: 76px;
    }
  }
</style>
