---
/** About / Why Me: no portrait by design. Identity + approach on the left, strengths on the right. */
import SectionIntro from '../SectionIntro.astro';
import Icon from '../Icon.astro';
import { skills } from '../../data/content';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__inner">
    <div class="about__story">
      <SectionIntro eyebrow="About me" title="Why work with me" id="about-title" />
      <p class="about__lead">
        I’m Leonard, a Product, UX and UI designer focused on early-stage consumer (B2C) AI products.
      </p>
      <p>
        My work centres on making complex products understandable: organizing information,
        structuring flows and designing clean interfaces people can use with confidence.
      </p>
      <p>
        Early-stage products move fast, and features often ship before the experience has time to
        mature. I help teams bring structure and clarity to what they’ve built, so users can
        understand what the product does, what is happening and what to do next.
      </p>
    </div>

    <div class="about__skills">
      <h3 class="about__skills-title">Strengths I bring</h3>
      <ul class="about__skills-grid">
        {
          skills.map((s) => (
            <li class="skill">
              <span class="skill__icon">
                <Icon name={s.icon} size={22} />
              </span>
              <div>
                <h4 class="skill__title">{s.title}</h4>
                <p class="skill__text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .about__story {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 34em;
  }

  .about__lead {
    margin-top: var(--space-2);
    color: var(--color-ink);
    font-size: var(--fs-body-lg);
    font-weight: 500;
  }

  .about__skills-title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .about__skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .skill {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .skill__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-primary-tint-strong);
    border-radius: 10px;
    color: var(--color-primary);
  }

  .skill__icon :global(svg) {
    stroke-width: 2;
  }

  .skill__title {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .skill__text {
    margin-top: 2px;
    color: var(--color-text-muted);
    font-size: var(--fs-label);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 600px) {
    .about__skills-grid {
      grid-template-columns: 1fr;
    }

    .skill {
      padding: var(--space-3);
    }
  }
</style>
