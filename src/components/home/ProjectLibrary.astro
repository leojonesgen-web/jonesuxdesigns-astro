---
import SectionHeader from '../SectionHeader.astro';
import ProjectCard from '../ProjectCard.astro';
import { libraryProjects } from '../../data/projects';
---

<section class="section library" id="work" aria-labelledby="work-title">
  <div class="container library__inner">
    <SectionHeader id="work-title" title="See what I can do" subtitle="A collection of my work" />
    <ul class="library__grid">
      {
        libraryProjects.map((project) => (
          <li>
            <ProjectCard project={project} rounded={false} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .library__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 36px;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .library__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
