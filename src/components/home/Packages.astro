---
/** Working Together: packages as starting points + the complimentary initial consultation. */
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import { consultation, packages } from '../../data/content';
---

<section class="section packages" id="packages" aria-labelledby="packages-title">
  <div class="container">
    <SectionIntro eyebrow="Working together" title="Ways we can work together" id="packages-title">
      <p>
        These packages are starting points, not rigid scopes. The engagement can be adjusted around
        the product, priorities, stage and actual problem.
      </p>
    </SectionIntro>

    <ul class="packages__grid">
      {
        packages.map((pkg) => (
          <li class="package">
            <h3 class="package__name">{pkg.name}</h3>
            <p class="package__price">{pkg.price}</p>
            <p class="package__text">{pkg.text}</p>
            <Button
              class="package__cta"
              variant="secondary"
              data-contact-intent={`the ${pkg.name}`}
              data-contact-heading={`Interested in the ${pkg.name}?`}
              aria-label={`Contact about ${pkg.name}`}
            >
              Contact
            </Button>
          </li>
        ))
      }
    </ul>

    <p class="packages__note">
      Scope and pricing remain open to discussion. Clicking Contact only starts a conversation; it
      doesn’t book or commit either of us to a package or price.
    </p>

    <div class="offer">
      <div class="offer__copy">
        <p class="offer__label">Before any package</p>
        <h3 class="offer__title">{consultation.name}</h3>
        <p class="offer__text">{consultation.text}</p>
      </div>
      <Button
        variant="primary"
        data-contact-intent="a complimentary initial UX consultation"
        data-contact-heading="Interested in a complimentary initial UX consultation?"
      >
        Contact
      </Button>
    </div>
  </div>
</section>

<style>
  .packages__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .package {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .package__name {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .package__price {
    color: var(--color-primary);
    font-size: 1.125rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .package__text {
    flex: 1;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--fs-label);
  }

  .package :global(.package__cta) {
    align-self: flex-start;
    margin-top: var(--space-3);
  }

  .packages__note {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .offer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1.5px solid var(--color-primary-tint-strong);
    border-radius: var(--radius-card);
  }

  .offer__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 60ch;
  }

  .offer__label {
    color: var(--color-primary);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .offer__title {
    font-size: var(--fs-h3);
    font-weight: 650;
  }

  .offer__text {
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .packages__grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .package {
      padding: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .offer {
      padding: var(--space-4);
    }

    .offer :global(.btn),
    .package :global(.package__cta) {
      align-self: stretch;
      width: 100%;
    }
  }
</style>
