---
/**
 * Hero: typography-led split with Leonard's cut-out photo standing directly on the section
 * (no frame; the bottom of the photo sits exactly on the hero's bottom edge), blue shapes behind
 * him, three floating "where I can help" chips, and a huge, very faint "B2C AI" behind everything.
 * Tablet/phone: text only, no photo or chips; the background word scales down.
 */
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/leonard-hero.png';
import { contactHref } from '../../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__word" aria-hidden="true">B2C AI</div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Product Designer</p>
      <h1 class="hero__title" id="hero-title">
        I design clearer experiences for <span class="hero__accent">B2C AI products.</span>
      </h1>
      <p class="hero__lead">
        I help early-stage consumer AI startups turn complex ideas and AI-powered features into
        clear, intuitive products people can understand and use.
      </p>
      <div class="hero__actions">
        <Button href="#work" size="lg">View selected work <Icon name="arrow-right" size={18} /></Button>
        <Button href={contactHref} variant="secondary" size="lg">Start a conversation</Button>
      </div>
    </div>

    <div class="hero__visual">
      <svg class="hero__art" viewBox="0 0 800 700" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="hero-shape-a" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#cfe0fb" />
            <stop offset="0.55" stop-color="#8db6f6" />
            <stop offset="1" stop-color="#4f8ef0" />
          </linearGradient>
          <linearGradient id="hero-shape-b" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.55" />
            <stop offset="1" stop-color="#dce8fd" stop-opacity="0.85" />
          </linearGradient>
        </defs>
        <!-- main tilted shape, sits right behind the photo (rises to the upper right) -->
        <rect x="130" y="150" width="600" height="400" rx="160" transform="rotate(-30 430 350)" fill="url(#hero-shape-a)" />
        <!-- lighter glass shape overlapping lower right -->
        <rect x="360" y="400" width="520" height="380" rx="150" transform="rotate(-30 620 590)" fill="url(#hero-shape-b)" stroke="#ffffff" stroke-opacity="0.9" stroke-width="2" />
        <!-- thin flowing lines -->
        <path d="M-60 720 C 80 520, 260 330, 600 170" fill="none" stroke="#ffffff" stroke-opacity="0.6" stroke-width="2" />
        <path d="M120 740 C 260 600, 480 500, 860 460" fill="none" stroke="#ffffff" stroke-opacity="0.7" stroke-width="1.5" />
      </svg>
      <Image
        class="hero__photo"
        src={heroPhoto}
        alt="Leonard Jones, Product Designer"
        widths={[440, 660, 880, 1073]}
        sizes="(max-width: 900px) 400px, 620px"
        loading="eager"
        fetchpriority="high"
      />
      <ul class="hero__chips" aria-label="Where I can help">
        <li class="hero__chip hero__chip--1">
          <span class="hero__chip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
          </span>
          Onboarding &amp; activation
        </li>
        <li class="hero__chip hero__chip--2">
          <span class="hero__chip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="2" /><path d="M7 11v4a2 2 0 0 0 2 2h4" /><rect x="13" y="13" width="8" height="8" rx="2" /></svg>
          </span>
          Complex AI workflows
        </li>
        <li class="hero__chip hero__chip--3">
          <span class="hero__chip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4" /></svg>
          </span>
          AI behavior &amp; user control
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-9) var(--space-10);
    overflow: hidden;
    /* Soft, airy blue wash that deepens toward the photo side */
    background:
      linear-gradient(180deg, var(--color-bg) 0, rgb(247 249 252 / 0) 140px),
      radial-gradient(60% 80% at 85% 45%, #dfeafd 0%, transparent 70%),
      linear-gradient(115deg, #f8faff 0%, #f1f6fe 45%, #e6effd 100%);
  }

  /* Huge, very faint filled word across the whole hero, behind text, shapes and photo */
  .hero__word {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    color: rgb(31 95 191 / 0.055);
    font-size: min(36vw, 520px);
    font-weight: 850;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    transform: translate(-50%, -46%);
    pointer-events: none;
    user-select: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__title {
    max-width: 16ch;
    font-size: var(--fs-display);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    color: var(--color-primary);
    white-space: nowrap;
  }

  .hero__lead {
    max-width: 34em;
    color: var(--color-text-muted);
    font-size: var(--fs-body-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  /* No frame: the photo is pulled down through the hero's bottom padding so it rests on the edge */
  .hero__visual {
    justify-self: end;
    align-self: end;
    width: 100%;
    max-width: 620px;
    margin-bottom: calc(var(--space-10) * -1);
  }

  .hero__visual {
    position: relative;
  }

  /* Decorative shapes, centred behind the photo and allowed to bleed past the column */
  .hero__art {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 0;
    width: 170%;
    max-width: none;
    height: auto;
    overflow: visible;
    transform: translateX(-46%);
    pointer-events: none;
  }

  .hero__photo {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }

  /* Floating glass chips around the photo (positions are relative to the photo column) */
  .hero__chips {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .hero__chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px 8px 8px;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 0.95);
    border-radius: 999px;
    box-shadow: 0 12px 32px rgb(31 95 191 / 0.16);
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__chip-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--color-primary-tint);
    border-radius: 50%;
    color: var(--color-primary);
  }

  .hero__chip--1 { right: 56%; bottom: 66%; }
  .hero__chip--2 { right: -8px; bottom: 58%; }
  .hero__chip--3 { right: 52%; bottom: 15%; }

  /* Narrower desktops: smaller chips that overlap the photo more, keeping clear of the copy */
  @media (max-width: 1180px) {
    .hero__chip {
      gap: 8px;
      padding: 6px 14px 6px 6px;
      font-size: 0.85rem;
    }

    .hero__chip-icon {
      width: 28px;
      height: 28px;
    }

    .hero__chip--1 { right: 44%; }
    .hero__chip--3 { right: 40%; }
  }

  /* ---------- Hero motion (page load) ---------- */
  :global(.motion) .hero__copy > * {
    animation: fade-up 700ms var(--ease) both;
  }

  :global(.motion) .hero__copy > :nth-child(2) { animation-delay: 80ms; }
  :global(.motion) .hero__copy > :nth-child(3) { animation-delay: 160ms; }
  :global(.motion) .hero__copy > :nth-child(4) { animation-delay: 240ms; }

  :global(.motion) .hero__word {
    animation: fade-in 1600ms ease both 200ms;
  }

  /* Shapes grow in, then drift very slowly */
  :global(.motion) .hero__art {
    animation:
      hero-shapes-in 1100ms var(--ease) both 150ms,
      hero-drift 16s ease-in-out 1.3s infinite alternate;
  }

  :global(.motion) .hero__photo {
    animation: hero-photo-in 900ms var(--ease) both 300ms;
  }

  /* Chips pop in one by one, then float gently */
  :global(.motion) .hero__chip {
    animation:
      hero-chip-in 600ms var(--ease) both,
      hero-float 6s ease-in-out infinite alternate;
  }

  :global(.motion) .hero__chip--1 { animation-delay: 750ms, 1350ms; }
  :global(.motion) .hero__chip--2 { animation-delay: 900ms, 2100ms; }
  :global(.motion) .hero__chip--3 { animation-delay: 1050ms, 2800ms; }

  @keyframes hero-shapes-in {
    from { opacity: 0; scale: 0.9; }
    to { opacity: 1; scale: 1; }
  }

  @keyframes hero-drift {
    from { rotate: 0deg; }
    to { rotate: 2deg; }
  }

  @keyframes hero-photo-in {
    from { opacity: 0; translate: 0 28px; }
    to { opacity: 1; translate: 0 0; }
  }

  @keyframes hero-chip-in {
    from { opacity: 0; scale: 0.85; }
    to { opacity: 1; scale: 1; }
  }

  @keyframes hero-float {
    from { translate: 0 0; }
    to { translate: 0 -8px; }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--space-7) var(--space-9);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero__title {
      max-width: 16ch;
    }

    /* Tablet and phone: centred copy */
    .hero__copy {
      align-items: center;
      text-align: center;
    }

    .hero__actions {
      justify-content: center;
    }

    /* Tablet and phone: typography-only hero, no photo or chips */
    .hero__visual {
      display: none;
    }

    /* The background word scales down and sits behind the headline */
    .hero__word {
      top: calc(156px - 6.6vw); /* centres the word on the headline from phone to tablet widths */
      font-size: 30vw;
      color: rgb(31 95 191 / 0.06);
      transform: translateX(-50%);
    }
  }

  @media (max-width: 480px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
