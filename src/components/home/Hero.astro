---
/**
 * Hero: typography-led split. The visual side is reserved for Leonard's real photograph;
 * until it is supplied, a clearly labelled placeholder holds the same space.
 */
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import { contactHref } from '../../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Product / UX / UI Designer</p>
      <h1 class="hero__title" id="hero-title">
        I design clearer experiences for <span class="hero__accent">B2C AI products.</span>
      </h1>
      <p class="hero__lead">
        I help early-stage consumer AI startups turn complex ideas and AI-powered features into
        clear, intuitive products people can understand and use.
      </p>
      <div class="hero__actions">
        <Button href="#work" size="lg">View selected work <Icon name="arrow-right" size={18} /></Button>
        <Button href={contactHref} variant="secondary" size="lg">Start a conversation</Button>
      </div>
    </div>

    <div class="hero__visual">
      <PhotoPlaceholder />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-10);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__title {
    max-width: 16ch;
    font-size: var(--fs-display);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    color: var(--color-primary);
    white-space: nowrap;
  }

  .hero__lead {
    max-width: 34em;
    color: var(--color-text-muted);
    font-size: var(--fs-body-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  /* Reserved for the real photograph (placeholder for now) */
  .hero__visual {
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--space-7) var(--space-9);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero__title {
      max-width: 16ch;
    }

    .hero__visual {
      justify-self: start;
      max-width: 400px;
    }
  }

  /* Mobile: the hero is typography-only; the project visual is hidden. */
  @media (max-width: 640px) {
    .hero__visual {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
