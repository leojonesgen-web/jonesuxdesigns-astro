---
/**
 * Hero: typography-led split. The visual side shows the three selected projects
 * (real work) rather than a portrait or invented interface.
 */
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { selectedProjects } from '../../data/projects';
import { contactHref } from '../../data/site';

const [first, second, third] = selectedProjects;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Product / UX / UI Designer</p>
      <h1 class="hero__title" id="hero-title">
        Product Designer for <span class="hero__accent">Early-Stage AI Products</span>
      </h1>
      <p class="hero__lead">
        I help AI startups turn complex or fast-built products into clear, coherent experiences
        users can understand and use.
      </p>
      <div class="hero__actions">
        <Button href="#work" size="lg">View selected work <Icon name="arrow-right" size={18} /></Button>
        <Button href={contactHref} variant="secondary" size="lg">Start a conversation</Button>
      </div>
    </div>

    <figure class="hero__work">
      <div class="hero__shot hero__shot--a" aria-hidden="true">
        <Image src={first.image} alt="" widths={[480, 720]} sizes="(max-width: 900px) 60vw, 380px" loading="eager" />
      </div>
      <div class="hero__shot hero__shot--b" aria-hidden="true">
        <Image src={third.image} alt="" widths={[400, 640]} sizes="(max-width: 900px) 50vw, 300px" loading="eager" />
      </div>
      <div class="hero__shot hero__shot--c" aria-hidden="true">
        <Image src={second.image} alt="" widths={[400, 640]} sizes="(max-width: 900px) 50vw, 320px" loading="eager" />
      </div>
      <figcaption class="hero__caption">
        Selected work: {first.title}, {third.title}, {second.title}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-10);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__title {
    max-width: 14ch;
    font-size: var(--fs-display);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    color: var(--color-primary);
  }

  .hero__lead {
    max-width: 34em;
    color: var(--color-text-muted);
    font-size: var(--fs-body-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  /* Overlapping stack of real project images */
  .hero__work {
    position: relative;
    aspect-ratio: 1 / 0.86;
  }

  .hero__shot {
    position: absolute;
    display: block;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
  }

  .hero__shot :global(img) {
    width: 100%;
    height: auto;
  }

  .hero__shot--a {
    top: 0;
    right: 0;
    width: 76%;
    z-index: 1;
  }

  .hero__shot--b {
    bottom: 6%;
    left: 0;
    width: 58%;
    z-index: 2;
  }

  .hero__shot--c {
    right: 4%;
    bottom: 0;
    width: 46%;
    z-index: 3;
  }

  .hero__caption {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--space-7) var(--space-9);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero__title {
      max-width: 16ch;
    }

    .hero__work {
      width: min(100%, 560px);
    }
  }

  @media (max-width: 480px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
