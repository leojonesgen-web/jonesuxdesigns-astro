---
/** Problems I Solve / How I Can Help: centred intro + four visual use-case cards. */
import SectionIntro from '../SectionIntro.astro';
import ProblemIllustration from '../ProblemIllustration.astro';
import { problems } from '../../data/content';
---

<section class="section problems" id="problems" aria-labelledby="problems-title">
  <div class="container">
    <SectionIntro eyebrow="Where I can help" title="When a powerful AI product is hard to use" id="problems-title" align="center">
      <p>
        Products are being built faster than their UX can mature. These are the problems I help
        early-stage teams solve.
      </p>
    </SectionIntro>

    <ul class="problems__grid">
      {
        problems.map((p) => (
          <li class="problem-card">
            <div class="problem-card__media">
              <ProblemIllustration name={p.illustration} />
            </div>
            <div class="problem-card__body">
              <h3 class="problem-card__title">{p.title}</h3>
              <p class="problem-card__text">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problems {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .problems__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .problem-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: border-color 250ms var(--ease), box-shadow 250ms var(--ease);
  }

  .problem-card:hover {
    border-color: var(--color-primary-tint-strong);
    box-shadow: 0 14px 34px rgb(31 95 191 / 0.1);
  }

  /* The illustration nudges up slightly on hover */
  .problem-card__media :global(svg) {
    transition: translate 350ms var(--ease);
  }

  .problem-card:hover .problem-card__media :global(svg) {
    translate: 0 -4px;
  }

  .problem-card__media {
    padding: var(--space-3) var(--space-2);
    background: var(--color-primary-tint);
    border-bottom: 1px solid var(--color-border);
  }

  .problem-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-4);
    text-align: center;
  }

  .problem-card__title {
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .problem-card__text {
    color: var(--color-text-muted);
    font-size: var(--fs-label);
    line-height: 1.55;
  }

  @media (max-width: 1100px) {
    .problems__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .problems__grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }
  }
</style>
