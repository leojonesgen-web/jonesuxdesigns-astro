---
import SectionIntro from '../SectionIntro.astro';
import Icon from '../Icon.astro';
import { problems } from '../../data/content';
---

<section class="section problems" id="problems" aria-labelledby="problems-title">
  <div class="container problems__inner">
    <SectionIntro eyebrow="Where I can help" title="When a powerful AI product is hard to use" id="problems-title" class="problems__intro">
      <p>
        Products are being built faster than their UX can mature. These are the problems I help
        early-stage teams solve.
      </p>
    </SectionIntro>

    <ol class="problems__list">
      {
        problems.map((p, i) => (
          <li class="problem">
            <span class="problem__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="problem__icon"><Icon name={p.icon} size={22} /></span>
            <div class="problem__body">
              <h3 class="problem__title">{p.title}</h3>
              <p class="problem__text">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .problems {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .problems__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .problems :global(.problems__intro) {
    position: sticky;
    top: calc(var(--header-height) + var(--space-5));
  }

  .problems__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .problem {
    display: grid;
    grid-template-columns: 40px 44px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .problem__index {
    padding-top: 10px;
    color: var(--color-steel);
    font-size: var(--fs-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .problem__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-primary-tint);
    border-radius: 10px;
    color: var(--color-primary);
  }

  .problem__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .problem__title {
    font-size: var(--fs-h3);
    font-weight: 650;
  }

  .problem__text {
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .problems__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .problems :global(.problems__intro) {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .problem {
      grid-template-columns: 44px minmax(0, 1fr);
      padding-block: var(--space-4);
    }

    .problem__index {
      display: none;
    }
  }
</style>
