---
/** FAQ: quieter accordion (native <details>, keyboard accessible without JS). */
import SectionIntro from '../SectionIntro.astro';
import Icon from '../Icon.astro';
import { faqs } from '../../data/content';
import { contactHref } from '../../data/site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <SectionIntro title="Questions founders ask" id="faq-title">
      <p>
        Something not covered here? Ask the portfolio assistant, or <a class="text-link" href={contactHref}>contact Leonard</a> directly.
      </p>
    </SectionIntro>

    <div class="faq__list">
      {
        faqs.map((item) => (
          <details class="faq__item">
            <summary>
              <span>{item.q}</span>
              <Icon name="chevron-down" size={20} class="faq__chevron" />
            </summary>
            <p class="faq__answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Quieter section directly after More Work on the same background. */
  .faq {
    padding-top: 0;
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
    padding-block: var(--space-3);
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    border-radius: 4px;
    transition: color var(--duration-base) var(--ease);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--color-primary);
  }

  .faq__item :global(.faq__chevron) {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--duration-base) var(--ease);
  }

  .faq__item[open] :global(.faq__chevron) {
    transform: rotate(180deg);
  }

  .faq__answer {
    max-width: 62ch;
    padding-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
