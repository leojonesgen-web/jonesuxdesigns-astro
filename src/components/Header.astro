---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Button from './Button.astro';
import { mainNav, site, type NavKey } from '../data/site';

interface Props {
  /** Which main-nav item is shown as active. Omit on pages that aren't in the nav. */
  current?: NavKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name}, home`}>
      <Image src={logo} alt="" width={85} height={40} loading="eager" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-header__toggle-bar" aria-hidden="true"></span>
    </button>

    <div class="site-header__menu" id="site-menu">
      <nav aria-label="Main">
        <ul class="site-nav">
          {
            mainNav.map((item) => (
              <li>
                <a
                  class:list={['site-nav__link', { 'is-active': item.key === current }]}
                  href={item.href}
                  aria-current={item.key === current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Button href="/#contact" variant="outline" size="md" class="site-header__cta">Contact</Button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after choosing a link (same-page anchors don't reload the page).
    header.querySelectorAll('#site-menu a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--color-page);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 84px;
    padding: 20px 42px;
  }

  .site-header__brand {
    flex-shrink: 0;
  }

  .site-header__menu {
    display: contents;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
  }

  .site-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    color: var(--color-text);
    font-family: var(--font-alt);
    font-size: 14px;
    font-weight: 900;
    line-height: 18px;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: var(--color-nav-active);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--color-nav-active);
  }

  .site-nav__link.is-active::after {
    opacity: 1;
  }

  .site-header__toggle {
    display: none;
  }

  /* Tablet: tighten spacing so everything still fits on one row */
  @media (max-width: 1024px) {
    .site-header__inner {
      padding-inline: var(--gutter);
    }

    .site-nav__link {
      padding: 0 14px;
    }
  }

  /* Mobile: collapse nav + CTA into a toggleable panel */
  @media (max-width: 860px) {
    .site-header__inner {
      min-height: 72px;
      padding-block: 16px;
    }

    .site-header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: transparent;
      border: 1px solid var(--color-border-soft);
      border-radius: 50%;
      color: var(--color-button-text);
      cursor: pointer;
    }

    .site-header__toggle-bar,
    .site-header__toggle-bar::before,
    .site-header__toggle-bar::after {
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 1px;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    .site-header__toggle-bar {
      position: relative;
    }

    .site-header__toggle-bar::before,
    .site-header__toggle-bar::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .site-header__toggle-bar::before {
      top: -6px;
    }

    .site-header__toggle-bar::after {
      top: 6px;
    }

    .is-open .site-header__toggle-bar {
      background: transparent;
    }

    .is-open .site-header__toggle-bar::before {
      transform: translateY(6px) rotate(45deg);
    }

    .is-open .site-header__toggle-bar::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .site-header__menu {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 8px var(--gutter) 24px;
      background: var(--color-white);
      box-shadow: 0 12px 24px -12px rgb(36 111 225 / 0.25);
    }

    .is-open .site-header__menu {
      display: flex;
    }

    .site-nav {
      flex-direction: column;
    }

    .site-nav__link {
      height: 48px;
      padding: 0 4px;
      font-size: 16px;
    }

    .site-nav__link::after {
      right: auto;
      width: 32px;
    }

    .site-header__menu :global(.site-header__cta) {
      align-self: flex-start;
    }
  }
</style>
