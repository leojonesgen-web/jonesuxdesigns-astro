---
interface Props {
  title: string;
  subtitle?: string;
  /** Heading id, used by the section's aria-labelledby. */
  id?: string;
}

const { title, subtitle, id } = Astro.props;
---

<header class="section-header">
  <h2 class="section-header__title" id={id}>{title}</h2>
  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .section-header__title {
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }

  .section-header__subtitle {
    max-width: 1040px;
    color: var(--color-text-subtle);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .section-header__title {
      font-size: 26px;
    }

    .section-header__subtitle {
      font-size: 16px;
    }
  }
</style>
