---
import type { ImageMetadata } from 'astro';
import IconTile from './IconTile.astro';

interface Props {
  label: string;
  icon: ImageMetadata;
  iconSize?: number;
}

const { label, icon, iconSize } = Astro.props;
---

<li class="value-card">
  <IconTile icon={icon} iconSize={iconSize} />
  <span class="value-card__label">{label}</span>
</li>

<style>
  .value-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .value-card__label {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }
</style>
