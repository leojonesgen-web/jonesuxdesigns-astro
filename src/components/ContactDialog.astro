---
/**
 * One shared contact dialog. Any element with `data-contact-intent="<name>"` opens it,
 * acknowledges the selection and pre-fills that intent into the WhatsApp/email message.
 * Opening it never books, buys or commits to anything.
 */
import ContactOptions from './ContactOptions.astro';
import Icon from './Icon.astro';
---

<dialog class="contact-dialog" aria-labelledby="contact-dialog-title" aria-describedby="contact-dialog-desc">
  <div class="contact-dialog__panel">
    <div class="contact-dialog__head">
      <h2 id="contact-dialog-title">Interested in this package?</h2>
      <button class="contact-dialog__close" type="button" aria-label="Close" data-dialog-close>
        <Icon name="close" size={20} />
      </button>
    </div>
    <p id="contact-dialog-desc" class="contact-dialog__desc">
      Choose how you’d like to get in touch. This only starts a conversation. It doesn’t book or
      commit either of us to a package or price.
    </p>
    <p class="contact-dialog__message">
      <span class="contact-dialog__message-label">Your message will start with</span>
      <span data-contact-message>“I’m interested in discussing this package.”</span>
    </p>
    <ContactOptions />
    <p class="contact-dialog__note">On LinkedIn, mention which package you’re interested in.</p>
  </div>
</dialog>

<script>
  import { contact } from '../data/site';

  const dialog = document.querySelector<HTMLDialogElement>('.contact-dialog');

  if (dialog) {
    const title = dialog.querySelector<HTMLElement>('#contact-dialog-title')!;
    const messageEl = dialog.querySelector<HTMLElement>('[data-contact-message]')!;
    const whatsapp = dialog.querySelector<HTMLAnchorElement>('[data-contact-link="whatsapp"]')!;
    const email = dialog.querySelector<HTMLAnchorElement>('[data-contact-link="email"]')!;
    let opener: HTMLElement | null = null;

    const open = (intent: string, heading: string, trigger: HTMLElement) => {
      const message = `Hi Leonard, I'm interested in discussing ${intent}.`;
      title.textContent = heading;
      messageEl.textContent = `“${message}”`;
      whatsapp.href = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(message)}`;
      email.href = `mailto:${contact.email}?subject=${encodeURIComponent(`Enquiry: ${intent}`)}&body=${encodeURIComponent(message)}`;
      opener = trigger;
      dialog.showModal();
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-contact-intent]');
      if (!trigger) return;
      event.preventDefault();
      open(trigger.dataset.contactIntent!, trigger.dataset.contactHeading ?? 'Get in touch', trigger);
    });

    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());

    // Click on the backdrop (outside the panel) closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .contact-dialog {
    width: min(480px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    background: var(--color-surface);
    border: 0;
    border-radius: 16px;
    box-shadow: var(--shadow-raised);
    color: var(--color-text);
  }

  .contact-dialog::backdrop {
    background: rgb(14 23 38 / 0.45);
  }

  .contact-dialog[open] {
    animation: dialog-in var(--duration-slow) var(--ease);
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .contact-dialog__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .contact-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .contact-dialog__head h2 {
    font-size: 1.375rem;
  }

  .contact-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin: -8px -8px 0 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease);
  }

  .contact-dialog__close:hover {
    background: var(--color-surface-muted);
    color: var(--color-ink);
  }

  .contact-dialog__desc,
  .contact-dialog__note {
    color: var(--color-text-muted);
    font-size: var(--fs-label);
  }

  .contact-dialog__message {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-primary-tint);
    border-radius: var(--radius-small);
    color: var(--color-ink);
    font-size: var(--fs-label);
  }

  .contact-dialog__message-label {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 640px) {
    .contact-dialog__panel {
      padding: var(--space-4);
    }
  }
</style>
