---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IconTile from './IconTile.astro';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  icon: ImageMetadata;
  iconSize?: number;
}

const { title, text, image, icon, iconSize } = Astro.props;
---

<li class="process-step">
  <Image class="process-step__image" src={image} alt="" width={262} height={196} />
  <div class="process-step__content">
    <IconTile icon={icon} iconSize={iconSize} size="lg" />
    <h3 class="process-step__title">{title}</h3>
    <p class="process-step__text">{text}</p>
  </div>
</li>

<style>
  .process-step {
    display: flex;
    flex-direction: column;
    gap: 45px;
  }

  .process-step__image {
    width: 100%;
    height: auto;
    aspect-ratio: 258 / 196;
    object-fit: cover;
  }

  .process-step__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .process-step__title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
  }

  .process-step__text {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .process-step {
      gap: 24px;
    }
  }
</style>
