---
/**
 * Project destination page, one per project in src/data/projects.ts.
 * V1 shows only approved information; full case-study content is added later.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { contactHref } from '../../data/site';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const category = project.page?.category ?? project.category;
const summary = project.page?.summary ?? project.summary;
---

<BaseLayout title={project.title} description={`${project.title}: ${summary}`}>
  <article class="section project">
    <div class="container project__inner">
      <a class="text-link project__back" href="/#work">← Back to portfolio</a>
      <header class="project__header" lang={project.page?.lang}>
        <p class="eyebrow">{category}</p>
        <h1 class="project__title">{project.title}</h1>
        <p class="project__summary">{summary}</p>
      </header>

      {
        !project.gallery && (
          <>
            <div class="project__media">
              <Image src={project.image} alt={project.imageAlt} widths={[640, 1024]} sizes="(max-width: 1024px) 100vw, 1024px" loading="eager" />
            </div>
            <p class="project__note">The full project write-up is being prepared.</p>
          </>
        )
      }
    </div>

    {
      project.gallery && (
        <div class="container"><div class:list={['gallery', { 'gallery--stroke': project.galleryStroke }]} style={project.galleryStroke ? `--gallery-stroke: ${project.galleryStroke}` : undefined}>
          {project.gallery.map((img, i) => (
            <Image
              class="gallery__image"
              src={img}
              alt={`${project.title} case study, slide ${i + 1} of ${project.gallery!.length}`}
              widths={[720, 1080, 1440, 2160, 2480].filter((w) => w < img.width).concat([Math.min(img.width, 2560)])}
              sizes="(max-width: 1288px) calc(100vw - 48px), 1240px"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div></div>
      )
    }

    <div class="container project__foot">
      <a class="text-link" href={contactHref}>Ask about this project <Icon name="arrow-right" size={18} /></a>
    </div>
  </article>
</BaseLayout>

<style>
  /* Case-study media: centred, constrained to the site container; each slide keeps its own proportions */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    margin-top: var(--space-6);
  }

  .gallery__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }

  /* Optional per-project stroke: 1px, fully opaque */
  .gallery--stroke .gallery__image {
    border: 1px solid var(--gallery-stroke);
  }

  .project__foot {
    margin-top: var(--space-6);
  }

  @media (max-width: 768px) {
    .gallery {
      gap: var(--space-2);
    }

    .gallery__image {
      border-radius: 10px;
    }
  }

  .project__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .project__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project__title {
    font-size: var(--fs-h1);
    font-weight: 750;
  }

  .project__summary {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: var(--fs-body-lg);
  }

  .project__media {
    width: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .project__media :global(img) {
    width: 100%;
    height: auto;
  }

  .project__note {
    color: var(--color-text-muted);
  }
</style>
