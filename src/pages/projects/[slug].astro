---
/**
 * Case-study route: one static page per entry in src/data/projects.ts.
 * Placeholder for now; the case-study content and layout will be built per project later.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <article class="section case-study">
    <div class="container case-study__inner">
      <a class="case-study__back" href="/#work">← Back to portfolio</a>
      <header class="case-study__header">
        <p class="case-study__eyebrow">Case study</p>
        <h1 class="case-study__title">{project.title}</h1>
        <p class="case-study__summary">{project.summary}</p>
      </header>

      <Image
        class="case-study__cover"
        src={project.thumbnail}
        alt=""
        widths={[600, 1024]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading="eager"
      />

      <div class="case-study__placeholder">
        <p>The full case study is coming soon.</p>
        <Button href="/#work" variant="outline" size="md">View other projects</Button>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: calc(1024px + var(--gutter) * 2);
  }

  .case-study__back {
    align-self: flex-start;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .case-study__back:hover {
    color: var(--color-primary);
  }

  .case-study__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .case-study__eyebrow {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study__title {
    color: var(--color-heading-strong);
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .case-study__summary {
    color: var(--color-text-muted);
    font-size: 18px;
  }

  .case-study__cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .case-study__placeholder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 32px;
    background: var(--color-footer-bg);
    border-radius: var(--radius-card);
    color: var(--color-footer-text);
  }
</style>
