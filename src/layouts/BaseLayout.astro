---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Assistant from '../components/Assistant.astro';
import { site } from '../data/site';
import { motionFlagScript } from '../scripts/motion-flag.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of the social preview image (1200 × 630 recommended). */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Keeps utility pages (e.g. 404) out of search results. */
  noindex?: boolean;
  /** Open Graph locale of the page's description, e.g. 'de_DE'. */
  locale?: string;
  /** Structured data for this page, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = '/og-image.png',
  imageAlt = `${site.name}: ${site.ownerFullName}, product designer for B2C AI products`,
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  locale = 'en_US',
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.ownerFullName} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#f7f9fc" />
  </head>
  <body>
    {/* First thing in <body> so it runs before anything paints. Allowed by its hash in the CSP (vercel.json). */}
    <script is:inline set:html={motionFlagScript} />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ContactDialog />
    <Assistant />
    <script>
      // Scroll reveal: elements fade up gently the first time they enter the viewport.
      const root = document.documentElement;
      if (root.classList.contains('motion') && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll<HTMLElement>(
          '.section-intro, .problem-card, .project-card, .process__steps, .about-split__photo, .about-split__heading, .about-split__text, .strengths__item, .way, .offer, .ways__note, .faq__side, .faq__list, .light-cta__inner, .final-contact__inner, .gallery__image',
        );
        // Stagger siblings that sit in the same grid/list.
        const counts = new Map<Element, number>();
        targets.forEach((el) => {
          el.classList.add('reveal');
          const parent = el.parentElement?.closest('ul, ol, .about-split__content, .faq__inner') ?? el.parentElement!;
          const n = counts.get(parent) ?? 0;
          counts.set(parent, n + 1);
          el.style.setProperty('--reveal-delay', `${Math.min(n, 5) * 80}ms`);
        });
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-revealed');
            io.unobserve(e.target);
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 18px;
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    color: #fff;
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
